{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insight.example/deployment/manifest-1.0.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestId", "schema", "image", "gateway", "supervisor", "modules"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "manifestId": {"const": "deployment-manifest-1.0.0"},
    "schema": {"const": "deployment/manifest.schema.json"},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "dockerfile", "context"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "dockerfile": {"const": "deployment/Dockerfile"},
        "context": {"const": "."}
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "exposed"],
      "properties": {
        "port": {"const": 8080},
        "exposed": {"const": true}
      }
    },
    "supervisor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid1", "entrypoint"],
      "properties": {
        "pid1": {"const": "tini"},
        "entrypoint": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "moduleId", "internalPort", "basePath", "proxyPrefix", "volume",
          "migration", "backup", "restore", "retention", "shutdown",
          "workingDirectory", "command", "environment", "databasePath"
        ],
        "properties": {
          "moduleId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "internalPort": {"type": "integer", "minimum": 1024, "maximum": 65535},
          "basePath": {"type": "string", "pattern": "^/[^ ]*$"},
          "proxyPrefix": {"type": "string", "pattern": "^/[^ ]*$"},
          "volume": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "mountPath", "writable"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
              "mountPath": {"type": "string", "pattern": "^/[^ ]*$"},
              "writable": {"const": true}
            }
          },
          "migration": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "readinessGate", "owner"],
            "properties": {
              "mode": {"const": "startup"},
              "readinessGate": {"const": true},
              "owner": {"type": "string", "minLength": 1}
            }
          },
          "backup": {
            "type": "object",
            "additionalProperties": false,
            "required": ["configured", "owner"],
            "properties": {
              "configured": {"const": true},
              "owner": {"type": "string", "minLength": 1}
            }
          },
          "restore": {
            "type": "object",
            "additionalProperties": false,
            "required": ["configured", "owner"],
            "properties": {
              "configured": {"const": true},
              "owner": {"type": "string", "minLength": 1}
            }
          },
          "retention": {
            "type": "object",
            "additionalProperties": false,
            "required": ["configured", "policyReference", "owner"],
            "properties": {
              "configured": {"const": true},
              "policyReference": {"type": "string", "minLength": 1},
              "owner": {"type": "string", "minLength": 1}
            }
          },
          "shutdown": {
            "type": "object",
            "additionalProperties": false,
            "required": ["signal", "timeoutSeconds"],
            "properties": {
              "signal": {"const": "SIGTERM"},
              "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 300}
            }
          },
          "workingDirectory": {"type": "string", "pattern": "^/opt/modules/[a-z][a-z0-9-]*$"},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "environment": {
            "type": "object",
            "additionalProperties": {"type": "string"}
          },
          "databasePath": {"type": "string", "pattern": "^/var/lib/insight/[a-z][a-z0-9-]*/[^ ]+$"}
        }
      }
    }
  }
}
