{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insight.example/deployment/manifest-1.0.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestId", "schema", "modules"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "manifestId": {"const": "deployment-manifest-1.0.0"},
    "schema": {"const": "deployment/manifest.schema.json"},
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "moduleId", "internalPort", "basePath", "proxyPrefix", "volume",
          "migration", "backup", "restore", "retention", "shutdown"
        ],
        "properties": {
          "moduleId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "internalPort": {"type": "integer", "minimum": 1024, "maximum": 65535},
          "basePath": {"type": "string", "pattern": "^/[^ ]*$"},
          "proxyPrefix": {"type": "string", "pattern": "^/[^ ]*$"},
          "volume": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "mountPath", "writable"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
              "mountPath": {"type": "string", "pattern": "^/[^ ]*$"},
              "writable": {"const": true}
            }
          },
          "migration": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "readinessGate", "owner"],
            "properties": {
              "mode": {"const": "startup"},
              "readinessGate": {"const": true},
              "owner": {"type": "string", "minLength": 1}
            }
          },
          "backup": {
            "type": "object",
            "additionalProperties": false,
            "required": ["configured", "owner"],
            "properties": {
              "configured": {"const": true},
              "owner": {"type": "string", "minLength": 1}
            }
          },
          "restore": {
            "type": "object",
            "additionalProperties": false,
            "required": ["configured", "owner"],
            "properties": {
              "configured": {"const": true},
              "owner": {"type": "string", "minLength": 1}
            }
          },
          "retention": {
            "type": "object",
            "additionalProperties": false,
            "required": ["configured", "policyReference", "owner"],
            "properties": {
              "configured": {"const": true},
              "policyReference": {"type": "string", "minLength": 1},
              "owner": {"type": "string", "minLength": 1}
            }
          },
          "shutdown": {
            "type": "object",
            "additionalProperties": false,
            "required": ["signal", "timeoutSeconds"],
            "properties": {
              "signal": {"const": "SIGTERM"},
              "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 300}
            }
          }
        }
      }
    }
  }
}
