{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:insight:authentication:1.0.0:auth-session",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "authenticated", "user", "session", "gates"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "authenticated": {"const": true},
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "username", "roles", "displayName"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "username": {"type": "string", "minLength": 1, "maxLength": 64},
        "roles": {"type": "array", "items": {"enum": ["admin", "psychiatrist"]}, "minItems": 1, "uniqueItems": true},
        "displayName": {"type": "string", "minLength": 1}
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "expiresAt"],
      "properties": {"id": {"type": "string", "minLength": 1}, "expiresAt": {"type": "string", "format": "date-time"}}
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disclaimerAccepted", "passwordChangeRequired"],
      "properties": {"disclaimerAccepted": {"type": "boolean"}, "passwordChangeRequired": {"type": "boolean"}}
    }
  }
}
