{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insight.example/contracts/common/1.0.0/identifiers.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id"],
  "properties": {
    "id": {"$ref": "#/$defs/Uuid"},
    "requestId": {"$ref": "#/$defs/Uuid"},
    "correlationId": {"$ref": "#/$defs/Uuid"},
    "causationId": {"$ref": "#/$defs/Uuid"},
    "schemaVersion": {"$ref": "#/$defs/SemVer"}
  },
  "$defs": {
    "Uuid": {"type": "string", "format": "uuid"},
    "SemVer": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "UtcTimestamp": {"type": "string", "format": "date-time"},
    "StableCode": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$"}
  }
}
